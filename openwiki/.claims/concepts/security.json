    {
      "id": "claim_95ca28e9567a43df90c3a37676010249",
      "statement": "MCPAuthMiddleware guards paths starting with /mcp or /api/mcp by extracting an API key from X-API-Key, then Authorization Bearer, then query token/api_key, returning 401 when absent, and authenticating by matching the key's first-8-character prefix against active api_tokens rows and bcrypt-verifying the full key before storing the row in the current_mcp_token ContextVar for the request duration.",
      "evidence": [
        {
          "resource": "repo://src/middlewares/mcp_auth.py#L11-L65",
          "version": "repo-lines-v1:sha256:6cbf7847aa61a20f38cce74891183d27b783d64b682302864fdffac2ef783cc1:"
        }
      ]
    },
    {
      "id": "claim_fb6e377e99a848f584a420a38316dd1e",
