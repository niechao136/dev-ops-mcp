        }
      ]
    },
    {
      "id": "claim_6832f540a6ad4032b9fcefdca25132ee",
      "statement": "The ORM schema consists of eight tables — users, api_tokens, projects, commands, public_commands, audit_logs, tasks, and automations — where projects cascade-delete their commands and automations reference both a project and a command by foreign key.",
      "evidence": [
        {
          "resource": "repo://src/dbs/orm.py#L14-L177",
          "version": "repo-lines-v1:sha256:b9d2aa828b836a67930687b2c92b3e46291242b73dd851746358b40f7281ea48:"
