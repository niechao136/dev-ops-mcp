    {
      "id": "claim_848b55133a9d4c29807f9d8888a75645",
      "statement": "A task's complete execution output accumulates in the tasks.output_log TEXT column and task status moves through pending, running, success, failed, timeout, and cancelled, so clients reconstruct logs by slicing that column rather than reading files.",
