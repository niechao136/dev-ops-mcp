    {
      "id": "claim_e3d19eac156e4a138e003225f6c14bb7",
      "statement": "All durable backend state lives in a single SQLite file at data/devops.db, opened through SQLAlchemy with check_same_thread=False because FastAPI serves requests from a thread pool.",
      "evidence": [
        {
          "resource": "repo://src/dbs/db.py#L25-L35",
          "version": "repo-lines-v1:sha256:a42d760570d003bffe3659015728958cd16d8ae4e85085582ee55b210549d001:"
        }
      ]
    },
    {
      "id": "claim_34c2c6dc06d440eca5e502c9fde9ebaf",
      "statement": "At FastAPI lifespan startup init_db() creates any missing tables, seeds an admin user from ADMIN_USERNAME/ADMIN_PASSWORD when absent, and seeds a default MCP API key (Fernet-encrypted plaintext plus bcrypt hash, bound to the admin user) when no api_tokens row matches DEFAULT_API_KEY.",
      "evidence": [
        {
          "resource": "repo://src/dbs/db.py#L52-L102",
          "version": "repo-lines-v1:sha256:35629e8fcef42b86694028b3dc6a437aa78d68f9c2c75f41f060c070892f3e40:"
