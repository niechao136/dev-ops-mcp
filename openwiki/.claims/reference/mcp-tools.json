    {
      "id": "claim_f5c3e68cc7ed486c9638fa47fd45e072",
      "statement": "MCPAuthMiddleware guards paths starting with /mcp or /api/mcp, extracting the key from X-API-Key, then Authorization Bearer, then query token/api_key, and authenticates by matching the first-8-character prefix against active api_tokens rows before hash-verifying the full key and storing the row in the current_mcp_token ContextVar.",
      "evidence": [
        {
          "resource": "repo://src/middlewares/mcp_auth.py#L15-L55",
          "version": "repo-lines-v1:sha256:3d26104bba699446f01114434bacaa502d20ab19af9bd77c0e9cd9b9ab97238d:"
        }
      ]
    },
    {
      "id": "claim_5e8af2d4f99e4787b1c63614d68e2b49",
      "statement": "The FastMCP app is mounted at /mcp with FastAPI root_path=/api, so the externally reachable MCP endpoint through the nginx gateway is /api/mcp, and the server is named devops-node-<MCP_NODE_NAME or hostname>.",
