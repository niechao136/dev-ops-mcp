    {
      "id": "claim_171e1ce8adef4ec6a85afdfe88bfe0ee",
      "statement": "execute_action returns requires_confirm without executing when the target command has requires_confirm=true and confirm is false, requiring an explicit user confirmation before a second call with confirm=true; it also rejects submissions while the project is locked by a running task.",
